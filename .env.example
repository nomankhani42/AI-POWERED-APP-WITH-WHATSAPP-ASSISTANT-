# Copy to .env and adjust as needed. Do NOT commit .env (it is git-ignored).
# This initialization feature requires no secrets; these are app-level defaults.

# Service name used in responses and logging
APP_NAME=voice-agent

# Deployment environment label: development | staging | production
ENVIRONMENT=development

# Uvicorn bind host/port
HOST=0.0.0.0
PORT=8000

# App log level for the app.* loggers. INFO prints the call flow (attended, welcome, each
# final transcript, replies, tool calls, fillers, playback, end). Set DEBUG to also see
# interim/partial transcripts printed live as the caller speaks.
LOG_LEVEL=INFO

# --- Conversational booking assistant (feature 002) ---
# Required (startup fails fast if missing):
OPENAI_API_KEY=replace-with-your-openai-api-key
MONGODB_URI=mongodb://localhost:27017

# Optional (defaults shown):
AGENT_MODEL=gpt-4.1
MONGODB_DB=voice_agent
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
# Business timezone used for today/tomorrow/relative booking dates.
BUSINESS_TIMEZONE=Asia/Karachi

# --- Voice call webhook & speech services (feature 003) ---
# Required (startup fails fast if missing):
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
CARTESIA_API_KEY=replace-with-your-cartesia-api-key
WHATSAPP_TOKEN=replace-with-your-whatsapp-access-token
WHATSAPP_PHONE_ID=replace-with-your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-your-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret

# Optional (defaults shown):
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
# Comma-separated Nova-3 keyterms. Use plain terms only—Deepgram keyterms have no weights.
DEEPGRAM_KEYTERMS=suite,deluxe,single room,double room,check-in,check-out,room availability,booking,reservation
# Format spoken dates/numbers and reject highly uncertain finalized transcripts.
STT_SMART_FORMAT=true
STT_MIN_CONFIDENCE=0.65
# Active calling-agent TTS voice/model. Cartesia settings remain available for rollback.
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Aura-2 speaking rate (0.7-1.5; 1.0 is the natural default).
DEEPGRAM_TTS_SPEED=1.0
CARTESIA_MODEL=sonic-3.5
# Cartesia managed buffering (ms): buffer streamed LLM tokens until there's enough context for
# natural, clear speech instead of synthesizing each tiny fragment. 0 disables; lower if laggy.
CARTESIA_MAX_BUFFER_DELAY_MS=3000
CARTESIA_VOICE_ID=replace-with-your-cartesia-voice-id
STT_SAMPLE_RATE=16000
GRAPH_API_VERSION=v21.0

# Automatic conversation loop (US4). WELCOME_MESSAGE is spoken on connect; empty disables it.
WELCOME_MESSAGE=Hello! Thanks for calling. I can help you check room availability, book a room, review your bookings, or cancel a booking. How can I help you today?
# No-input window (seconds): re-prompt once after this silence, then end the call (FR-014).
CALLER_SILENCE_TIMEOUT_S=10

# --- Clear playback & real-time streaming loop (feature 004) ---
# Optional (defaults shown):
# Outbound TTS sample rate; matches the Opus wire rate so playback isn't garbled.
TTS_OUTPUT_SAMPLE_RATE=48000
# Fail a stalled provider stream instead of leaving the caller in silence.
TTS_FIRST_AUDIO_TIMEOUT_S=10
TTS_EVENT_TIMEOUT_S=10
# Maximum wait for the WebRTC ICE/DTLS transport before starting the welcome.
MEDIA_CONNECT_TIMEOUT_S=20
# Silence (ms) before a caller turn is finalized (~0.8 s); and the UtteranceEnd backstop.
STT_ENDPOINTING_MS=800
STT_UTTERANCE_END_MS=1000
# Extra silent retries of an STT/TTS op before a spoken apology, then continue the call.
PROVIDER_RETRY_ATTEMPTS=1
# Optional: stop playback when the caller speaks over the assistant.
BARGE_IN_ENABLED=false

# --- Tool-tailored spoken fillers (feature 005) ---
# Spoken the instant a tool call is detected, so the caller isn't left in silence while a
# lookup/booking runs. Tailored per tool; FILLER_GENERIC is the fallback for other tools.
FILLER_GENERIC=Let me check that for you…
FILLER_CHECK_AVAILABILITY=Let me find that for you…
FILLER_BOOK_ROOM=One moment, I'm booking that…
FILLER_CANCEL_BOOKING=Let me cancel that…
FILLER_LIST_BOOKINGS=Let me pull up your bookings…

# LOCAL DEBUG ONLY — set to true to bypass webhook signature verification when you
# don't have the real App Secret yet. NEVER enable on a public/production URL.
WHATSAPP_SKIP_SIGNATURE=false
